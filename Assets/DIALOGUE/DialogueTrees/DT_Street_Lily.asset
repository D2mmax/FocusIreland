  m_Script: {fileID: 11500000, guid: e7d52d21a72ca374996a821ea5a856cc, type: 3}
  m_Name: DT_Street_Lily
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTree
  startNodeID: start
  nodes:
  - nodeID: start
    speaker: 0
    dialogueText: There you are. I've been standing here for ages.
    continueNodeID: question
    choices: []
  - nodeID: question
    speaker: 0
    dialogueText: So where did you move to? Is it far? Did you get your own room?
    continueNodeID:
    choices:
    - choiceText: Did you seriously wait out here the whole time?
      nextNodeID: humour_1
      ehcEffect:
        energyDelta: 0
        hopeDelta: 0
        connectionDelta: 1
    - choiceText: It's kind of small actually.
      nextNodeID: honest_1
      ehcEffect:
        energyDelta: 0
        hopeDelta: 0
        connectionDelta: 2
    - choiceText: Can we just go to class?
      nextNodeID: shutdown_1
      ehcEffect:
        energyDelta: 0
        hopeDelta: 0
        connectionDelta: 0
  - nodeID: humour_1
    speaker: 0
    dialogueText: Obviously. Now answer the question.
    continueNodeID: humour_2
    choices: []
  - nodeID: humour_2
    speaker: 1
    dialogueText: It's grand. Different.
    continueNodeID: humour_3
    choices: []
  - nodeID: humour_3
    speaker: 0
    dialogueText: Different how?
    continueNodeID: humour_4
    choices: []
  - nodeID: humour_4
    speaker: 1
    dialogueText: Just different.
    continueNodeID: humour_5
    choices: []
  - nodeID: humour_5
    speaker: 0
    dialogueText: You're useless.
    continueNodeID: converge
    choices: []
  - nodeID: honest_1
    speaker: 0
    dialogueText: Ah that's rubbish. Did you at least get your own room?
    continueNodeID: honest_2
    choices: []
  - nodeID: honest_2
    speaker: 1
    dialogueText: Sort of.
    continueNodeID: honest_3
    choices: []
  - nodeID: honest_3
    speaker: 0
    dialogueText: What does sort of mean?
    continueNodeID: honest_4
    choices: []
  - nodeID: honest_4
    speaker: 1
    dialogueText: It's just temporary.
    continueNodeID: honest_5
    choices: []
  - nodeID: honest_5
    speaker: 0
    dialogueText: Oh right. Okay.
    continueNodeID: converge
    choices: []
  - nodeID: shutdown_1
    speaker: 0
    dialogueText: Yeah, course. Sorry.
    continueNodeID: converge
    choices: []
  - nodeID: converge
    speaker: 0
    dialogueText: Come on, we're going to be late. Mr Byrne'll lose it.
