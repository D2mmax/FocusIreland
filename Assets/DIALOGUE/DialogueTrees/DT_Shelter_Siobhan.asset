  m_Name: DT_Shelter_Siobhan
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTree
  startNodeID: start
  nodes:
  - nodeID: start
    speaker: 0
    dialogueText: Did you sleep okay?
    continueNodeID:
    choices:
    - choiceText: Yeah, fine.
      nextNodeID: yeah_fine
      ehcEffect:
        energyDelta: 0
        hopeDelta: 0
        connectionDelta: 0
      modeTag: humour
    - choiceText: Not really.
      nextNodeID: not_really
      ehcEffect:
        energyDelta: 1
        hopeDelta: 0
        connectionDelta: 5
      modeTag: honest
    - choiceText: (Say nothing. Sit down and eat the toast.)
      nextNodeID: say_nothing
      ehcEffect:
        energyDelta: 0
        hopeDelta: 0
        connectionDelta: -15
      modeTag: shutdown
  - nodeID: yeah_fine
    speaker: 0
    dialogueText: Good. Eat your toast.
    continueNodeID: closing_1
    choices: []
  - nodeID: not_really
    speaker: 0
    dialogueText: Me neither.
    continueNodeID: not_really_2
    choices: []
  - nodeID: not_really_2
    speaker: 0
    dialogueText: It'll get easier. The noise takes a while to tune out.
    continueNodeID: closing_1
    choices: []
  - nodeID: say_nothing
    speaker: 0
    dialogueText: Right then.
    continueNodeID: closing_1
    choices: []
  - nodeID: closing_1
    speaker: 0
    dialogueText: I'll be home by six. There's money in the front pocket of your bag if you want something at lunch.
    continueNodeID: closing_2
    choices: []
  - nodeID: closing_2
    speaker: 0
    dialogueText: And Ciarán. Just - try today, yeah?
    continueNodeID:
    choices: []
