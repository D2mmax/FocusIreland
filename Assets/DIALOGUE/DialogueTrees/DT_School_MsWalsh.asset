  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7d52d21a72ca374996a821ea5a856cc, type: 3}
  m_Name: DT_School_MsWalsh
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTree
  startNodeID: start
  nodes:
  - nodeID: start
    speaker: 0
    dialogueText: Good morning. Before we get started I need everyone to complete
      the activity on the board. It should help you focus for the day. Are you ready?
    choices:
    - choiceText: Yeah I'm ready
      nextNodeID: ready
      ehcEffect:
        energyDelta: 0
        hopeDelta: 10
        connectionDelta: 0
    - choiceText: I'm really tired today
      nextNodeID: tired
      ehcEffect:
        energyDelta: -10
        hopeDelta: 0
        connectionDelta: 0
    - choiceText: Do I have to?
      nextNodeID: reluctant
      ehcEffect:
        energyDelta: 0
        hopeDelta: -10
        connectionDelta: 0
  - nodeID: ready
    speaker: 0
    dialogueText: Great attitude. Head to your desk and get started.
    choices: []
  - nodeID: tired
    speaker: 0
    dialogueText: I know mornings are hard. Do your best, that is all I ask.
    choices: []
  - nodeID: reluctant
    speaker: 0
    dialogueText: I am afraid so. Everyone has to do it. I think you might actually
      enjoy it.
    choices: []
