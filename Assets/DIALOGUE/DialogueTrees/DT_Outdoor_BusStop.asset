MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7d52d21a72ca374996a821ea5a856cc, type: 3}
  m_Name: DT_Outdoor_BusStop
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTree
  startNodeID: start
  nodes:
  - nodeID: start
    speaker: 0
    dialogueText: The bus to school is here. It will cost you your last euro. What
      do you do?
    choices:
    - choiceText: Take the bus
      nextNodeID: bus
      ehcEffect:
        energyDelta: 10
        hopeDelta: 0
        connectionDelta: 0
    - choiceText: Walk to school
      nextNodeID: walk
      ehcEffect:
        energyDelta: -15
        hopeDelta: 0
        connectionDelta: 10
  - nodeID: bus
    speaker: 0
    dialogueText: You get on the bus and find a seat by the window. At least you
      will not be late.
    choices: []
  - nodeID: walk
    speaker: 0
    dialogueText: You start walking. It is a long way but the morning air is cool.
      You will probably be late but at least you kept your last euro.
    choices: []
